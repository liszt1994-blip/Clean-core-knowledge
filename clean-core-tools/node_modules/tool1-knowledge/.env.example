# SAP AI Core + BTP Destination Service Configuration
# Copy this file to .env for local development

# ── SAP AI Core + Destination Service (required) ─────────────────────────────
# Paste the full VCAP_SERVICES JSON from your BTP CF space (cf env <app>)
# Must include both "aicore" and "destination" service bindings:
VCAP_SERVICES={"aicore":[{"credentials":{"clientid":"<YOUR_AICORE_CLIENTID>","clientsecret":"<YOUR_AICORE_SECRET>","url":"https://<YOUR_SUBDOMAIN>.authentication.<REGION>.hana.ondemand.com","serviceurls":{"AI_API_URL":"https://api.ai.<REGION>.aws.ml.hana.ondemand.com"}}}],"destination":[{"credentials":{"uri":"https://destination-configuration.cfapps.<REGION>.hana.ondemand.com","url":"https://<YOUR_SUBDOMAIN>.authentication.<REGION>.hana.ondemand.com","clientid":"<YOUR_DEST_CLIENTID>","clientsecret":"<YOUR_DEST_SECRET>"}}]}

# ── AI Core Deployment (override defaults if needed) ─────────────────────────
AICORE_DEPLOYMENT_ID=d6efeabe29c1a3f6
AICORE_MODEL=anthropic--claude-4.6-sonnet
AICORE_RESOURCE_GROUP=docgrp

# ── BTP Destination for SAP Support Portal (optional) ────────────────────────
# Name of the BTP Destination configured to proxy https://me.sap.com
# See README for setup instructions. Default: SAP_SUPPORT_PORTAL
# DEST_SAP_SUPPORT=SAP_SUPPORT_PORTAL
